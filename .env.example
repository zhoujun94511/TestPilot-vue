# ===========================================
# Flask 基础配置
# ===========================================
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
FLASK_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=5001
LOG_LEVEL=DEBUG #DEBUG/INFO/WARNING/ERROR/CRITICAL

# ===========================================
# AI 提供商启用控制
# ===========================================
# 精确控制每个服务（新增）
ENABLE_OPENAI=false
ENABLE_DEEPSEEK=false
ENABLE_OLLAMA=false
ENABLE_GEMINI=true
ENABLE_QWEN=false

# ===========================================
# AI 提供商配置
# 默认AI提供商 (openai/ollama/deepseek/gemini/qwen)
# ===========================================

# OpenAI 配置
# DEFAULT_COMPANY=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_MODEL=gpt-5 # 或者 gpt-4o, gpt-4o-mini 等
# GPT5_VERBOSITY=low  # low, medium, high
# GPT5_REASONING_EFFORT=minimal # minimal, low, medium, high

# Gemini 配置
# DEFAULT_COMPANY=gemini
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-3.8-flash

# Qwen 配置
DEFAULT_COMPANY=qwen
QWEN_API_KEY=YOUR_QWEN_API_KEY
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
QWEN_TEMPERATURE=0.7

# DeepSeek 配置
# DEFAULT_COMPANY=deepseek
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash

# Ollama 配置 (本地)
# DEFAULT_COMPANY=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=phi:2.7b
# OLLAMA_MODEL=mistral:7b-instruct-q4
# OLLAMA_MODEL=tinyllama:1.1b
# OLLAMA_MODEL=gemma:2b

# ===========================================
# LLM 统一超时配置（适用于所有模型）
# 注意：Ollama 不支持 timeout 参数，由底层 HTTP 客户端控制
# ===========================================
LLM_TIMEOUT_DEFAULT=120
LLM_TIMEOUT_CASE_GENERATION=300
LLM_TIMEOUT_REQUIREMENT_ANALYSIS=300

# ===========================================
# 性能配置 (在 config/settings.py 中定义)
# ===========================================
CHUNK_SIZE=1000
MAX_MEMORY_MB=500
MAX_WORKERS=3

# ===========================================
# 优化配置 (在 utils/optimization_config.py 中使用)
# ===========================================
# 基础优化配置
MAX_CASE_NUM=50
MAX_TOKENS=4000
TR_OPENAI_MAX_TOKENS=8000
TR_DEEPSEEK_MAX_TOKENS=8000
TR_GEMINI_MAX_TOKENS=8000
TR_QWEN_MAX_TOKENS=8000
ENABLE_PARALLEL=true
ENABLE_STREAMING=false
CASE_COUNT_OPTIONS=5,10,20,30,40,50

# 内容去重配置
CONTENT_SIMILARITY_THRESHOLD=0.8
ENABLE_CONTENT_DEDUP=true
CONTENT_DEDUP_WEIGHTS={"title": 0.4, "steps": 0.3, "expected": 0.2, "preconditions": 0.1}
CONTENT_DEDUP_BATCH_SIZE=100
ENABLE_CONTENT_DEDUP_REPORT=false

# ===========================================
# 数据库和存储配置
# ===========================================
CHROMA_COLLECTION_NAME=testpilot_knowledge
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# ===========================================
# RAG 配置
# ===========================================
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
