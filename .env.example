# ===========================================
# Flask 基础配置
# ===========================================
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
FLASK_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=5001
LOG_LEVEL=DEBUG #DEBUG/INFO/WARNING/ERROR/CRITICAL

# ===========================================
# 认证与 RBAC（默认关闭，兼容单机匿名使用）
# ===========================================
# AUTH_REQUIRE_AUTH=true 时：除 /api/auth/* 外所有 API 需登录
AUTH_REQUIRE_AUTH=false
# 是否开放自助注册（默认关闭，由 super_admin/admin 开户）
AUTH_REGISTER_ENABLED=false
# 自助注册的账号先停用，管理员在「用户管理」启用后才能登录（关闭后注册即可读写默认部门数据）
AUTH_REGISTER_REQUIRE_APPROVAL=true
# 仅在可信反向代理之后开启：按 X-Forwarded-For 识别客户端 IP（否则可伪造绕过限流）
AUTH_TRUST_PROXY_HEADERS=false
# 首次空库引导超管（仅 users 表为空时生效）
AUTH_BOOTSTRAP_SUPER_USERNAME=admin
AUTH_BOOTSTRAP_SUPER_PASSWORD=
AUTH_BOOTSTRAP_SUPER_EMAIL=

# 开发可选：python scripts/seed_demo_users.py 确保 超管+admin+user 三账号（勿用于生产）
# SEED_DEMO_SUPER_USERNAME=admin
# SEED_DEMO_SUPER_PASSWORD=
# SEED_DEMO_ADMIN_USERNAME=dept_admin
# SEED_DEMO_ADMIN_PASSWORD=
# SEED_DEMO_USER_USERNAME=demo_user
# SEED_DEMO_USER_PASSWORD=

# 登录失败锁定（需 AUTH_REQUIRE_AUTH=true 时生效）
AUTH_LOCK_ENABLED=true
AUTH_LOCK_MAX_FAILURES=5
AUTH_LOCK_DURATION_SECONDS=900
# 认证操作审计落库 auth_audit_logs
AUTH_AUDIT_ENABLED=true
# 密码须含字母、数字、符号（开发可 false）
AUTH_PASSWORD_REQUIRE_COMPLEXITY=true
# 向量 metadata 失败项定时重试间隔（秒，0=关闭）
VECTOR_METADATA_RETRY_INTERVAL_SECONDS=300

# ===========================================
# AI 提供商启用控制
# ===========================================
# 精确控制每个服务（新增）
ENABLE_OPENAI=false
ENABLE_DEEPSEEK=false
ENABLE_OLLAMA=false
ENABLE_GEMINI=true
ENABLE_QWEN=false
ENABLE_ANTHROPIC=false

# ===========================================
# AI 提供商配置
# 默认AI提供商 (openai/ollama/deepseek/gemini/qwen/anthropic)
# ===========================================

# OpenAI 配置
# DEFAULT_COMPANY=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_MODEL=gpt-5 # 或者 gpt-4o, gpt-4o-mini 等
# GPT5_VERBOSITY=low  # low, medium, high
# GPT5_REASONING_EFFORT=minimal # minimal, low, medium, high

# Gemini 配置
# DEFAULT_COMPANY=gemini
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-3.8-flash

# Qwen 配置
DEFAULT_COMPANY=qwen
QWEN_API_KEY=YOUR_QWEN_API_KEY
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
QWEN_TEMPERATURE=0.7

# DeepSeek 配置
# DEFAULT_COMPANY=deepseek
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash

# Anthropic / Claude。走 Messages API，不走 OpenAI 兼容地址。
# 当前型号（claude-sonnet-5-5 等）不接受 temperature。短别名 sonnet/opus/haiku/fable 会自动映射。
# DEFAULT_COMPANY=anthropic
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama 配置 (本地)
# DEFAULT_COMPANY=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=phi:2.7b
# OLLAMA_MODEL=mistral:7b-instruct-q4
# OLLAMA_MODEL=tinyllama:1.1b
# OLLAMA_MODEL=gemma:2b

# ===========================================
# LLM 统一超时配置（适用于所有模型）
# 注意：Ollama 不支持 timeout 参数，由底层 HTTP 客户端控制
# ===========================================
LLM_TIMEOUT_DEFAULT=120
LLM_TIMEOUT_CASE_GENERATION=300
LLM_TIMEOUT_REQUIREMENT_ANALYSIS=300

# ===========================================
# 性能配置 (在 config/settings.py 中定义)
# ===========================================
CHUNK_SIZE=1000
MAX_MEMORY_MB=500
MAX_WORKERS=3

# ===========================================
# 优化配置 (在 utils/optimization_config.py 中使用)
# ===========================================
# 基础优化配置
MAX_CASE_NUM=50
# 运行期以配置中心为准；以下为冷启动/无 DB 时的默认值
MAX_TOKENS=4000
TR_MAX_TOKENS=8000
TOKEN_MAX_PER_SESSION=50000
TOKEN_MAX_CALLS_PER_SESSION=100
# legacy（init_config_center 会与 TR_MAX_TOKENS 同步；运行期以配置中心为准）
TR_OPENAI_MAX_TOKENS=8000
TR_DEEPSEEK_MAX_TOKENS=8000
TR_GEMINI_MAX_TOKENS=8000
TR_QWEN_MAX_TOKENS=8000
ENABLE_PARALLEL=true
ENABLE_STREAMING=false
CASE_COUNT_OPTIONS=5,10,20,30,40,50

# 内容去重配置
CONTENT_SIMILARITY_THRESHOLD=0.8
ENABLE_CONTENT_DEDUP=true
CONTENT_DEDUP_WEIGHTS={"title": 0.4, "steps": 0.3, "expected": 0.2, "preconditions": 0.1}
CONTENT_DEDUP_BATCH_SIZE=100
ENABLE_CONTENT_DEDUP_REPORT=false
# 用例生成与聊天共用，默认开启
ENABLE_HALLUCINATION_DETECTION=true

# ===========================================
# 数据库和存储配置
# ===========================================
CHROMA_COLLECTION_NAME=testpilot_knowledge
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# ===========================================
# RAG 配置
# ===========================================
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
